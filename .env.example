# KeepFlip eBay OAuth Function - server-side variables only
# Never expose CLIENT_SECRET, token encryption keys, or refresh tokens as EXPO_PUBLIC_* variables.

# Sandbox eBay keyset
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RU_NAME=

# Production eBay keyset
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_RU_NAME=

# Approved scope list shared by both eBay environments. Values are space-separated.
EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/commerce.identity.readonly https://api.ebay.com/oauth/api_scope/sell.inventory

# Return from the HTTPS Appwrite callback back into the native app
EBAY_APP_RETURN_URL=keepflip://ebay/connected

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EBAY_TOKEN_ENCRYPTION_KEY=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EBAY_OAUTH_STATE_SECRET=

# Fresh server-only token collection
APPWRITE_EBAY_DATABASE_ID=keepflip
APPWRITE_EBAY_CONNECTIONS_COLLECTION_ID=
APPWRITE_EBAY_OAUTH_STATES_COLLECTION_ID=ebay_oauth_states
APPWRITE_EBAY_ITEMS_TABLE_ID=items
APPWRITE_EBAY_ITEM_PHOTOS_TABLE_ID=item_photos
APPWRITE_EBAY_ITEM_IMAGES_BUCKET_ID=item_images

# APPWRITE_FUNCTION_API_ENDPOINT and APPWRITE_FUNCTION_PROJECT_ID are runtime variables
# supplied by Appwrite. Do not create EXPO_PUBLIC copies of them for this function.
